---
/*
  Dive easter eggs 🤿
  1. Depth gauge  — a small dive computer shows your "depth" as you scroll.
                    Hit the bottom and it warns you; head back up fast and it
                    reminds you to do a 3-minute safety stop at 5 m.
  2. Bubbles      — click/tap anywhere in the hero to exhale bubbles.
  3. Sea life     — type "manta" or "shark" (or the Konami code) and
                    something big glides past.
  4. OK signal    — click the logo 5 times for a diver's 👌.
  5. Console      — open dev tools for a hello from the surface.
*/
---
<div class="dive-computer" id="diveComputer" aria-hidden="true" title="Your dive computer">
  <span class="dc-label">DEPTH</span>
  <span class="dc-depth"><b id="dcDepth">0.0</b>m</span>
  <span class="dc-time" id="dcTime">00:00</span>
</div>
<div class="dive-toast" id="diveToast" role="status" aria-live="polite"></div>
<div class="sea-layer" id="seaLayer" aria-hidden="true"></div>

<template id="mantaTpl">
  <!-- Manta seen from above, head pointing right (direction of travel) -->
  <svg viewBox="0 0 190 220" class="critter manta">
    <!-- whip tail -->
    <path d="M58 108 C40 108 22 112 2 120" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round"/>
    <!-- body + swept-back wings -->
    <path d="M150 110
             C150 94 140 80 124 68
             C106 54 84 32 64 6
             C68 34 72 58 72 74
             C72 88 66 98 56 104
             C52 107 52 113 56 116
             C66 122 72 132 72 146
             C72 162 68 186 64 214
             C84 188 106 166 124 152
             C140 140 150 126 150 110 Z" fill="currentColor"/>
    <!-- cephalic fins (the 'horns' in front of the mouth) -->
    <path d="M146 98 C158 92 170 92 178 98 C170 102 160 104 148 104 Z" fill="currentColor"/>
    <path d="M146 122 C158 128 170 128 178 122 C170 118 160 116 148 116 Z" fill="currentColor"/>
    <!-- pale shoulder patches -->
    <path d="M128 84 C116 80 104 74 94 64 C100 78 108 88 120 94 Z" fill="#fff" opacity=".22"/>
    <path d="M128 136 C116 140 104 146 94 156 C100 142 108 132 120 126 Z" fill="#fff" opacity=".22"/>
  </svg>
</template>
<template id="sharkTpl">
  <!-- Whale shark, side view. Drawn head-left, then mirrored so the head leads as it swims right. -->
  <svg viewBox="0 0 300 120" class="critter whaleshark">
    <g transform="translate(300 0) scale(-1 1)" fill="currentColor">
      <!-- fins (behind body) -->
      <path d="M128 30 C134 16 144 6 158 2 C155 12 158 22 168 32 Z"/>               <!-- first dorsal -->
      <path d="M204 43 C208 37 213 33 220 31 C218 36 220 42 224 47 Z"/>             <!-- second dorsal -->
      <path d="M70 80 C78 95 92 107 110 114 C105 102 101 92 98 82 Z"/>              <!-- pectoral -->
      <path d="M174 79 C178 87 184 92 192 94 C190 87 190 81 190 76 Z"/>             <!-- pelvic -->
      <path d="M212 68 C216 74 221 77 227 79 C225 73 225 68 227 63 Z"/>             <!-- anal -->
      <path d="M234 52 C250 40 268 22 288 4 C283 26 278 44 271 57 C278 67 284 78 290 94 C272 84 254 73 234 63 Z"/> <!-- crescent tail -->
      <!-- body: broad flat head, tapering to the tail -->
      <path d="M5 58 C5 47 14 39 30 35 C70 25 120 24 160 30 C190 34 214 42 238 52 L238 63 C214 71 190 78 160 82 C120 88 70 88 36 80 C17 76 6 69 5 58 Z"/>
    </g>
    <g transform="translate(300 0) scale(-1 1)" fill="none" stroke="#fff" stroke-linecap="round">
      <path d="M7 61 C16 64 26 64 36 61" stroke-width="2" opacity=".7"/>               <!-- wide mouth -->
      <path d="M48 46 L50 70 M54 45 L56 71 M60 44 L62 72 M66 44 L67 72" stroke-width="1.5" opacity=".35"/> <!-- gill slits -->
      <path d="M44 42 C100 31 170 34 232 54 M50 56 C110 50 170 54 232 58" stroke-width="1.5" opacity=".25"/> <!-- body ridges -->
    </g>
    <g transform="translate(300 0) scale(-1 1)" fill="#fff">
      <circle cx="24" cy="50" r="2.2" opacity=".9"/>                                  <!-- eye -->
      <g opacity=".5">
        <circle cx="80" cy="38" r="2.6"/><circle cx="96" cy="44" r="2.6"/><circle cx="112" cy="36" r="2.6"/><circle cx="128" cy="44" r="2.6"/>
        <circle cx="144" cy="38" r="2.6"/><circle cx="160" cy="46" r="2.6"/><circle cx="176" cy="42" r="2.4"/><circle cx="192" cy="48" r="2.2"/>
        <circle cx="88" cy="62" r="2.6"/><circle cx="104" cy="68" r="2.6"/><circle cx="120" cy="60" r="2.6"/><circle cx="136" cy="68" r="2.6"/>
        <circle cx="152" cy="62" r="2.6"/><circle cx="168" cy="66" r="2.4"/><circle cx="184" cy="62" r="2.2"/><circle cx="206" cy="56" r="2"/>
        <circle cx="34" cy="44" r="1.8"/><circle cx="40" cy="54" r="1.8"/><circle cx="30" cy="64" r="1.8"/>
      </g>
    </g>
  </svg>
</template>

<style is:global>
  .dive-computer { position: fixed; left: 16px; bottom: 16px; z-index: 40; display: grid; grid-template-columns: auto auto; gap: 0 10px; align-items: baseline; padding: 8px 12px; border-radius: 12px; background: rgba(11, 26, 60, .85); backdrop-filter: blur(6px); color: #d6f3fe; font: 600 11px/1.3 ui-monospace, Menlo, monospace; border: 1px solid rgba(0, 176, 240, .35); box-shadow: 0 6px 20px rgba(0,0,0,.25); opacity: 0; transform: translateY(10px); transition: opacity .3s, transform .3s, border-color .3s; pointer-events: none; }
  .dive-computer.on { opacity: 1; transform: none; }
  .dive-computer.warn { border-color: #ff5a5a; }
  .dive-computer.warn .dc-depth { color: #ff8a8a; }
  .dc-label { grid-column: 1 / -1; letter-spacing: .2em; color: #00b0f0; font-size: 9px; }
  .dc-depth { font-size: 13px; }
  .dc-depth b { font-size: 22px; }
  .dc-time { opacity: .7; }

  .dive-toast { position: fixed; left: 50%; bottom: 24px; z-index: 60; transform: translate(-50%, 140%); max-width: calc(100% - 32px); padding: 12px 18px; border-radius: 999px; background: #0a6cc2; color: #fff; font-weight: 600; font-size: .95rem; box-shadow: 0 10px 30px rgba(0,0,0,.3); transition: transform .4s cubic-bezier(.2,.9,.3,1.3); text-align: center; }
  .dive-toast.show { transform: translate(-50%, 0); }

  .sea-layer { position: fixed; inset: 0; pointer-events: none; z-index: 45; overflow: hidden; }
  .bubble { position: absolute; border-radius: 50%; border: 1.5px solid rgba(255,255,255,.8); background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.7), rgba(255,255,255,.08) 60%); animation: rise var(--dur, 2.4s) ease-in forwards; }
  @keyframes rise {
    0% { transform: translate(0, 0) scale(.4); opacity: 0; }
    10% { opacity: 1; }
    100% { transform: translate(var(--drift, 0px), -70vh) scale(1); opacity: 0; }
  }
  .critter { position: absolute; color: #0a2a5c; filter: drop-shadow(0 20px 30px rgba(0,0,0,.25)); }
  .critter.manta { width: min(200px, 40vw); color: #10234d; animation: glide 9s linear forwards; }
  .critter.whaleshark { width: min(560px, 90vw); color: #1b3f73; animation: glide 13s linear forwards; }
  @keyframes glide {
    0% { transform: translateX(-110%) translateY(0) rotate(4deg); }
    25% { transform: translateX(25vw) translateY(-30px) rotate(-3deg); }
    50% { transform: translateX(50vw) translateY(10px) rotate(3deg); }
    75% { transform: translateX(80vw) translateY(-20px) rotate(-2deg); }
    100% { transform: translateX(120vw) translateY(0) rotate(2deg); }
  }
  .hero { cursor: crosshair; }
  @media (prefers-reduced-motion: reduce) { .critter, .bubble { display: none; } }
</style>

<script>
  const layer = document.getElementById('seaLayer')!;
  const toastEl = document.getElementById('diveToast')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let toastTimer: number | undefined;

  function toast(msg: string, ms = 3800) {
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toastEl.classList.remove('show'), ms);
  }

  // ---------- 1. Bubbles ----------
  function bubbles(x: number, y: number, n = 8) {
    if (reduced) return;
    for (let i = 0; i < n; i++) {
      const b = document.createElement('span');
      const size = 6 + Math.random() * 18;
      b.className = 'bubble';
      Object.assign(b.style, {
        width: `${size}px`, height: `${size}px`,
        left: `${x - size / 2 + (Math.random() - .5) * 30}px`, top: `${y - size / 2}px`,
        animationDelay: `${Math.random() * .4}s`,
      });
      b.style.setProperty('--dur', `${1.8 + Math.random() * 1.6}s`);
      b.style.setProperty('--drift', `${(Math.random() - .5) * 80}px`);
      layer.appendChild(b);
      b.addEventListener('animationend', () => b.remove());
    }
  }
  document.querySelector('.hero')?.addEventListener('click', (e) => {
    const ev = e as MouseEvent;
    if ((ev.target as HTMLElement).closest('a,button')) return;
    bubbles(ev.clientX, ev.clientY);
  });

  // ---------- 2. Depth gauge + safety stop ----------
  const MAX_DEPTH = 30; // metres, bottom of the page
  const dc = document.getElementById('diveComputer')!;
  const depthEl = document.getElementById('dcDepth')!;
  const timeEl = document.getElementById('dcTime')!;
  const start = Date.now();
  let maxReached = 0, warnedDeep = false, lastY = scrollY, lastT = performance.now(), toldStop = false;

  function updateDepth() {
    const range = document.documentElement.scrollHeight - innerHeight;
    const depth = range > 0 ? (scrollY / range) * MAX_DEPTH : 0;
    depthEl.textContent = depth.toFixed(1);
    dc.classList.toggle('on', depth > 0.5);
    dc.classList.toggle('warn', depth > 28);
    maxReached = Math.max(maxReached, depth);

    if (depth > 29.5 && !warnedDeep) {
      warnedDeep = true;
      toast('⚠️ 30 m — you’ve hit the bottom! Time to book your dive ↑');
    }
    // Fast ascent from deep → safety stop reminder
    const now = performance.now();
    const speed = (lastY - scrollY) / Math.max(1, now - lastT); // px per ms upward
    if (!toldStop && maxReached > 15 && depth < 6 && speed > 3) {
      toldStop = true;
      toast('🛑 Ascending too fast! Don’t forget your 3-minute safety stop at 5 m.');
    }
    lastY = scrollY; lastT = now;
  }
  addEventListener('scroll', updateDepth, { passive: true });
  setInterval(() => {
    const s = Math.floor((Date.now() - start) / 1000);
    timeEl.textContent = `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
  }, 1000);
  updateDepth();

  // ---------- 3. Sea life on secret words / Konami ----------
  function spawn(kind: 'manta' | 'shark') {
    if (reduced) { toast(kind === 'manta' ? '🌊 A manta ray just glided past!' : '🦈 A whale shark swam by!'); return; }
    const tpl = document.getElementById(kind === 'manta' ? 'mantaTpl' : 'sharkTpl') as HTMLTemplateElement;
    const el = tpl.content.firstElementChild!.cloneNode(true) as SVGElement;
    el.style.top = `${15 + Math.random() * 50}vh`;
    layer.appendChild(el);
    el.addEventListener('animationend', () => el.remove());
    toast(kind === 'manta' ? '🌊 Manta spotted! Tofo is famous for them.' : '🦈 Whale shark! Gentle giants — plankton only, promise.');
  }
  const konami = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
  let typed = '', kIdx = 0;
  addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (t && (t.isContentEditable || /INPUT|TEXTAREA|SELECT/.test(t.tagName))) return;
    kIdx = e.key === konami[kIdx] ? kIdx + 1 : (e.key === konami[0] ? 1 : 0);
    if (kIdx === konami.length) { kIdx = 0; spawn('manta'); setTimeout(() => spawn('shark'), 1500); return; }
    if (e.key.length === 1) {
      typed = (typed + e.key.toLowerCase()).slice(-12);
      if (typed.endsWith('manta')) spawn('manta');
      else if (typed.endsWith('shark')) spawn('shark');
      else if (typed.endsWith('bubbles')) bubbles(innerWidth / 2, innerHeight - 40, 30);
    }
  });

  // ---------- 4. OK signal on logo ----------
  let logoClicks = 0, logoTimer: number | undefined;
  document.querySelector('.brand img')?.addEventListener('click', () => {
    logoClicks++;
    clearTimeout(logoTimer);
    logoTimer = window.setTimeout(() => (logoClicks = 0), 1200);
    if (logoClicks === 5) {
      logoClicks = 0;
      const r = (document.querySelector('.brand img') as HTMLElement).getBoundingClientRect();
      bubbles(r.left + r.width / 2, r.top + r.height, 16);
      toast('👌 OK? OK! (That’s diver for “all good”.)');
    }
  });

  // ---------- 5. Console hello ----------
  console.log(
    '%c  ><(((º>   ><>   ><(((º>\n%c🤿 Hello from the surface, fellow diver!\nTry typing "manta", "shark" or "bubbles" on the page — or the Konami code.',
    'color:#00b0f0;font:bold 16px monospace',
    'color:#0a6cc2;font:600 13px sans-serif',
  );
</script>
